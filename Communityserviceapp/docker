# Build Stage
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app
COPY pom.xml .
RUN mvn dependency:go-offline -B
COPY src ./src

# Compile classes and unpack dependencies into folders
RUN mvn clean package -DskipTests && \
    mvn dependency:copy-dependencies -DoutputDirectory=target/dependency

# Runtime Stage
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app

# Copy compiled classes and dependencies separately
COPY --from=build /app/target/classes /app/classes
COPY --from=build /app/target/dependency /app/dependency

EXPOSE 8080

# Run Java directly using the classpath wildcard
# Replace your current ENTRYPOINT with running the built jar file
ENTRYPOINT ["java", "-jar", "target/Communityserviceapp-0.0.1-SNAPSHOT.jar"]
