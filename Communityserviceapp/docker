# Stage 1: Build stage
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app

COPY pom.xml .
COPY src ./src

# Compile and copy runtime dependencies into target/dependency
RUN mvn clean package -DskipTests && \
    mvn dependency:copy-dependencies -DoutputDirectory=target/dependency

# Stage 2: Run stage
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app

# Copy compiled classes and target dependencies
COPY --from=build /app/target/classes /app/classes
COPY --from=build /app/target/dependency /app/dependency

EXPOSE 8080

# Execute using classpath scanning
# Example standard execution format:
CMD ["java", "-cp", "classes:dependency/*", "com.yourpackage.MainApplication"]
