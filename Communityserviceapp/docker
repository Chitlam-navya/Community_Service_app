# Stage 1: Build the Spring Boot application with Maven
FROM maven:3.9-eclipse-temurin-17 AS build
WORKDIR /app

# Copy Maven setup and source files
COPY pom.xml .
COPY src ./src

# Package into a specific JAR file name
RUN mvn clean package -DskipTests -DfinalName=app

# Stage 2: Create lightweight image for execution
FROM eclipse-temurin:17-jre-alpine
WORKDIR /app

# Copy the explicitly named JAR from build stage
COPY --from=build /app/target/app.jar app.jar

# Expose Spring Boot port
EXPOSE 8080

# Start Spring Boot application
ENTRYPOINT ["java", "-jar", "app.jar"]
